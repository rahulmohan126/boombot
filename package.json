{
  "name": "boombot",
  "version": "2.1.2",
  "description": "A music bot for discord",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "docker:publish": "docker buildx build --platform linux/amd64,linux/arm64 --pull --no-cache -t rahulmohan126/boombot:$npm_package_version -t rahulmohan126/boombot:latest --push .",
    "docker:build:local": "docker build --platform linux/arm64 -t boombot:local .",
    "docker:run:local": "docker run --rm --name boombot-local --platform linux/arm64 -v \"$PWD/settings.json:/boombot/settings.json\" -v \"$PWD/cookies.json:/boombot/cookies.json\" -v \"$PWD/data:/boombot/data\" boombot:local",
    "docker:local": "pnpm docker:build:local && pnpm docker:run:local"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulmohan126/BoomBot.git"
  },
  "author": "rahulmohan126",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rahulmohan126/BoomBot/issues"
  },
  "homepage": "https://github.com/rahulmohan126/BoomBot#readme",
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "ffmpeg-static": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "pino-roll": "^4.0.0",
    "undici": "^8.12.4",
    "youtubei.js": "^18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "sonic-boom": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
